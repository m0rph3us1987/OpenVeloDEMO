generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Ingredient {
  id               String              @id @default(cuid())
  name             String              @unique
  category         String
  defaultUnit      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  recipeIngredients RecipeIngredient[]
  cookLogs         CookLog[]
  cartItems        CartItem[]
}

model Recipe {
  id          String             @id @default(cuid())
  title       String
  description String?
  servings    Int                @default(1)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  ingredients RecipeIngredient[]
  mealSlots   MealPlanSlot[]
  cookLogs    CookLog[]
  cartSnapshots CartSnapshot[]
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Float
  // App-validated enum (g|ml|pcs). The database also enforces the set via
  // a CHECK constraint in the initial migration and an idempotent trigger
  // installed by apps/api/scripts/ensure-db.mjs at bootstrap.
  unit         String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([recipeId])
  @@index([ingredientId])
}

model MealPlanSlot {
  id           String     @id @default(cuid())
  // ISO week string "YYYY-Www", e.g. "2026-W30".
  week         String
  // 1 = Monday, ..., 7 = Sunday. Calendar date is derived from weekStart + (day - 1).
  day          Int
  date         DateTime
  slot         String
  recipeId     String
  servings     Int        @default(1)
  notes        String?
  createdAt    DateTime   @default(now())
  recipe       Recipe     @relation(fields: [recipeId], references: [id])
  cookLogs     CookLog[]

  @@index([recipeId])
  @@index([week, day])
}

model CookLog {
  id              String        @id @default(cuid())
  recipeId        String
  ingredientId    String?
  // Optional tie to the planned slot the cook event originated from. Historical
  // cook logs without a planned slot have null here.
  mealPlanSlotId  String?
  cookedAt        DateTime      @default(now())
  notes           String?
  recipe          Recipe        @relation(fields: [recipeId], references: [id])
  ingredient      Ingredient?   @relation(fields: [ingredientId], references: [id])
  mealPlanSlot    MealPlanSlot? @relation(fields: [mealPlanSlotId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@index([mealPlanSlotId])
  @@index([cookedAt])
}

model CartSnapshot {
  id        String   @id @default(cuid())
  recipeId  String?
  takenAt   DateTime @default(now())
  itemsJson String
  recipe    Recipe?  @relation(fields: [recipeId], references: [id])

  @@index([recipeId])
}

model CartItem {
  id           String   @id @default(cuid())
  // ISO week string "YYYY-Www".
  week         String
  ingredientId String
  unit         String
  quantity     Float
  // 'auto' derived from weekly plan; 'manual' added by user.
  source       String
  // Optional free-form note (used by manual lines).
  note         String?
  updatedAt    DateTime @updatedAt
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([week])
  @@index([week, ingredientId])
}

model CartHistory {
  id         String   @id @default(cuid())
  // ISO week label "YYYY-Www"; one row per past week.
  week       String   @unique
  weekStart  String
  weekEnd    String
  weekLabel  String
  itemsJson  String
  takenAt    DateTime @default(now())
}
